{
  "entities": {
    "Vacation": {
      "title": "Vacation",
      "description": "A scheduled team vacation or leave entry",
      "type": "object",
      "properties": {
        "employeeName": {
          "type": "string",
          "description": "Full name of the employee",
          "minLength": 1,
          "maxLength": 100
        },
        "startDate": {
          "type": "string",
          "description": "Start date of vacation in YYYY-MM-DD format",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "description": "End date of vacation in YYYY-MM-DD format",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "color": {
          "type": "string",
          "description": "Hex color code for employee visual identification",
          "minLength": 4,
          "maxLength": 9,
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or reason for leave",
          "maxLength": 500
        },
        "userId": {
          "type": "string",
          "description": "UID of user who created the vacation record",
          "minLength": 1,
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "description": "Email address of user who created the record",
          "minLength": 3,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp in ISO format",
          "maxLength": 50
        }
      },
      "required": [
        "employeeName",
        "startDate",
        "endDate",
        "color",
        "userId",
        "userEmail"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile and vacation preferences for a team member",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Full display name of the user",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "minLength": 3,
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL or preset photo",
          "maxLength": 1000
        },
        "jobTitle": {
          "type": "string",
          "description": "Job title or role in company",
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "description": "Department or team name",
          "maxLength": 100
        },
        "favoriteColor": {
          "type": "string",
          "description": "Default signature color for team vacation calendar",
          "minLength": 4,
          "maxLength": 9,
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
        },
        "phone": {
          "type": "string",
          "description": "Emergency contact or phone number",
          "maxLength": 30
        },
        "bio": {
          "type": "string",
          "description": "Short bio or notes about vacation preferences",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp in ISO format",
          "maxLength": 50
        }
      },
      "required": [
        "userId",
        "displayName",
        "email",
        "favoriteColor"
      ]
    }
  },
  "firestore": {
    "/vacations/{vacationId}": {
      "schema": "Vacation",
      "description": "Collection of team vacation entries visible to all team members, editable by owner"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles visible to all team members, editable only by the owner user"
    }
  }
}
